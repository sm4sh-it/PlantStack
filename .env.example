# Open Plantbook API credentials (optional, required for search)
# Generate these by registering at https://open.plantbook.io
OPENPLANTBOOK_CLIENT_ID="your_client_id_here"
OPENPLANTBOOK_CLIENT_SECRET="your_client_secret_here"

# Security & Access Protection (must be explicitly defined in .env for Docker Compose)
# Set a strong secret to require authentication for Web UI and API access (recommended).
# Or explicitly set "" ONLY on a trusted private home LAN without password.
PLANTSTACK_API_SECRET=""

# Dedicated read-only token strictly scoped to GET /api/plants/status
# Recommended for Home Assistant, MagicMirror, or ESPHome widgets.
# Accepted via Authorization: Bearer, X-API-Key, or ?token=.
PLANTSTACK_STATUS_TOKEN=""

# Docker host bind address (defaults to 0.0.0.0 for direct home LAN access).
# Set to 127.0.0.1 if PlantStack sits behind a reverse proxy on the same host.
PLANTSTACK_BIND_ADDR="0.0.0.0"

# Reverse proxy & CSRF configuration (optional)
# Set PLANTSTACK_TRUST_PROXY="true" only when running behind a trusted reverse proxy.
PLANTSTACK_TRUST_PROXY="false"
# Comma-separated external origins allowed by CSRF checks (e.g. https://plants.example.com)
PLANTSTACK_PUBLIC_ORIGIN=""
