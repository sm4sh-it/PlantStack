# Open Plantbook API credentials (optional, required for search)
# Generate these by registering at https://open.plantbook.io
OPENPLANTBOOK_CLIENT_ID="your_client_id_here"
OPENPLANTBOOK_CLIENT_SECRET="your_client_secret_here"

# Security & Access Protection (optional)
# Leave empty for open home LAN mode without password.
# Set a strong secret to require authentication for Web UI and API access.
PLANTSTACK_API_SECRET=""
